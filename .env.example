# ─────────────────────────────────────────────────────────────────────────────
# Admin API
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the real Admin API, including the version prefix.
# Leave this UNSET to run against the bundled demo dataset instead.
# ADMIN_API_BASE_URL=https://your-domain.com/api/v1/admin

# Name of the admin session cookie. Must match the API's cookie name.
# ADMIN_SESSION_COOKIE=session

# ─────────────────────────────────────────────────────────────────────────────
# Client
# ─────────────────────────────────────────────────────────────────────────────

# Same-origin path the browser calls. The route handler at
# src/app/api/admin/[...path]/route.ts forwards it upstream.
# Only change this if you mount the proxy somewhere else.
# NEXT_PUBLIC_API_PREFIX=/api/admin

# Set to any value to hide the "any credentials work" hint on the login screen.
# NEXT_PUBLIC_HIDE_DEMO_HINT=1
